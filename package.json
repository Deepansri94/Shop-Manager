{
  "name": "@deepansri94/shop-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Xerox & Stationery Shop Business Management App",
  "main": "main.js",
  "author": "Shop Owner",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "build": {
    "appId": "com.shopmanager.app",
    "productName": "Shop Manager",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Shop Manager"
    },
    "files": [
      "**/*",
      "!server/auth_info/**",
      "!.git/**",
      "!*.bat",
      "!assets/**",
      "!docs/**",
      "!*.md"
    ],
    "asarUnpack": [
      "server/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "electron-winstaller@5.4.0": true
  }
}
